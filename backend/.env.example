# Application Settings
APP_NAME=ppt-ai-backend
DEBUG=True

# Database Configuration (SQLite for easy setup, PostgreSQL for production)
DATABASE_URL=sqlite:///./pptai.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/pptai

# JWT Authentication
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Settings (comma-separated list)
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# AWS S3 (Optional - for future implementation)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET_NAME=your-bucket-name

# OpenAI (Optional - for future implementation)
OPENAI_API_KEY=your-openai-api-key
